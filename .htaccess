Options -Indexes
DirectoryIndex index.html

ErrorDocument 403 /index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Canonicalize the legacy Guides landing page directly to the final URL.
RewriteCond %{REQUEST_URI} ^/guides/index\.html$ [NC]
RewriteRule ^ https://www.calculatepilot.com/guides/ [R=301,L,NE]

# Canonical host + HTTPS: https://www.calculatepilot.com
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^calculatepilot\.com$ [NC]
RewriteRule ^ https://www.calculatepilot.com%{REQUEST_URI} [R=301,L,NE]

# Missing slash on locale hubs: /frfinancial-calculators.html -> /fr/financial-calculators.html
RewriteRule ^(fr|de|es)(financial|health|math|other)-calculators\.html$ /$1/$2-calculators.html [R=301,L]

# Moved EN calculator
RewriteRule ^financial/car-depreciation-calculator\.html$ /other/car-depreciation-calculator.html [R=301,L]

# Stale asset filenames from older templates
RewriteRule ^css/style\.css$ /css/styles.css [R=301,L]
RewriteRule ^js/site\.js$ /js/language-selector.js [R=301,L]
RewriteRule ^js/percentage-calculator\.js$ /js/percentage.js [R=301,L]

# Unpublished locale URL -> English original (stops Ahrefs 404 errors)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(fr|de|es)/(.+)$ /$2 [R=301,L]

# Privacy-first analytics consent and site-wide language selector.
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  SubstituteMaxLineLength 2m
  Substitute "s|<script async src=\"https://www.googletagmanager.com/gtag/js\?id=G-YFZBQ0VRQS\"></script>||i"
  Substitute "s|<script src=\"https://analytics.ahrefs.com/analytics.js\" data-key=\"HAKNwRlvdHsSgoa1o6fIfA\" async></script>||i"
  Substitute "s|</head>|<script src=\"/js/consent.js?v=20260908\" defer></script>\n<script src=\"https://www.calculatepilot.com/js/language-selector.js?v=20260923\" defer></script>\n</head>|i"
  Substitute "s|\"@type\": \"SoftwareApplication\"|\"@type\": \"WebApplication\"|"
  Substitute "s|\"@type\":\"SoftwareApplication\"|\"@type\":\"WebApplication\"|"
  Substitute "s| *\"browserRequirements\": \"Requires a modern web browser\",||"
  Substitute "s| *\"browserRequirements\":\"Requires a modern web browser\",||"
  Substitute "s|<li><a href=\"/guides/index.html\">Guides</a></li>|<li><a href=\"/guides/\">Guides</a></li>\n      <li><a href=\"/pricing.html\">Pricing</a></li>|"
  Substitute "s|<li><a href=\"/guides/\">Guides</a></li>|<li><a href=\"/guides/\">Guides</a></li>\n      <li><a href=\"/pricing.html\">Pricing</a></li>|"
  Substitute "s|<li><a href=\"/embed/\">Embed Calculators</a></li>|<li><a href=\"/embed/\">Embed Calculators</a></li>\n          <li><a href=\"/pricing.html\">Pricing</a></li>|"
  Substitute "s|None of those is a currency overlay of a US page.</p>|None of those is a currency overlay of a US page. Start with mortgage, loan, or UK take-home pay, then open amortization or refinance when you need the payment split.</p>|"
  Substitute "s|<title>Trigonometry Calculator — Sin, Cos, Tan & Inverse Functions \\| CalculatePilot</title>|<title>Trigonometry Calculator — Sin, Cos & Tan \\| CalculatePilot</title>|"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
