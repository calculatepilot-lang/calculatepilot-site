Options -Indexes
DirectoryIndex index.html

ErrorDocument 403 /index.html
ErrorDocument 404 /404.html

RewriteEngine On

RewriteRule ^guides/index\.html$ /guides/ [R=301,L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^calculatepilot\.com$ [NC]
RewriteRule ^(.*)$ https://www.calculatepilot.com/$1 [L,R=301]

<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  SubstituteMaxLineLength 2m
  Substitute "s|<script async src=\"https://www.googletagmanager.com/gtag/js\?id=G-YFZBQ0VRQS\"></script>||i"
  Substitute "s|<script src=\"https://analytics.ahrefs.com/analytics.js\" data-key=\"HAKNwRlvdHsSgoa1o6fIfA\" async></script>||i"
  Substitute "s|</head>|<link rel=\"alternate\" hreflang=\"en\" href=\"https://www.calculatepilot.com%{REQUEST_URI}\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://fr.calculatepilot.com%{REQUEST_URI}\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://de.calculatepilot.com%{REQUEST_URI}\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://es.calculatepilot.com%{REQUEST_URI}\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://www.calculatepilot.com%{REQUEST_URI}\">\n<script src=\"/js/consent.js?v=20260830\" defer></script>\n<script src=\"https://www.calculatepilot.com/js/language-selector.js?v=20260903\" defer></script>\n</head>|i"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
