Options -Indexes
DirectoryIndex index.html

ErrorDocument 403 /index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Legacy language subdomains -> canonical language subdirectories.
RewriteCond %{HTTP_HOST} ^(fr|de|es)\.calculatepilot\.com$ [NC]
RewriteRule ^(.*)$ https://www.calculatepilot.com/%1/$1 [R=301,L,NE]

# Canonicalize the Guides landing page.
RewriteRule ^guides/index\.html$ /guides/ [R=301,L]

# Force HTTPS.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www on the English apex host only.
RewriteCond %{HTTP_HOST} ^calculatepilot\.com$ [NC]
RewriteRule ^(.*)$ https://www.calculatepilot.com/$1 [L,R=301]

# Privacy-first analytics consent and site-wide language selector.
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  SubstituteMaxLineLength 2m
  Substitute "s|<script async src=\"https://www.googletagmanager.com/gtag/js\?id=G-YFZBQ0VRQS\"></script>||i"
  Substitute "s|<script src=\"https://analytics.ahrefs.com/analytics.js\" data-key=\"HAKNwRlvdHsSgoa1o6fIfA\" async></script>||i"
  Substitute "s|</head>|<script src=\"/js/consent.js?v=20260830\" defer></script>\n<script src=\"https://www.calculatepilot.com/js/language-selector.js?v=20260905\" defer></script>\n</head>|i"
</IfModule>

# Cache static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
