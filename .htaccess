Options -Indexes
DirectoryIndex index.html

ErrorDocument 403 /index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Canonicalize the legacy Guides landing page directly to the final URL.
# This must run before the host/scheme rule so it remains a single-hop redirect.
RewriteCond %{REQUEST_URI} ^/guides/index\.html$ [NC]
RewriteRule ^ https://www.calculatepilot.com/guides/ [R=301,L,NE]

# Canonical host + HTTPS: https://www.calculatepilot.com
# One rule handles all three non-canonical variants in a single 301:
#   http://calculatepilot.com/*
#   http://www.calculatepilot.com/*
#   https://calculatepilot.com/*
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^calculatepilot\.com$ [NC]
RewriteRule ^ https://www.calculatepilot.com%{REQUEST_URI} [R=301,L,NE]

# Privacy-first analytics consent and site-wide language selector.
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  SubstituteMaxLineLength 2m
  Substitute "s|<script async src=\"https://www.googletagmanager.com/gtag/js\?id=G-YFZBQ0VRQS\"></script>||i"
  Substitute "s|<script src=\"https://analytics.ahrefs.com/analytics.js\" data-key=\"HAKNwRlvdHsSgoa1o6fIfA\" async></script>||i"
  Substitute "s|</head>|<script src=\"/js/consent.js?v=20260908\" defer></script>\n<script src=\"https://www.calculatepilot.com/js/language-selector.js?v=20260903\" defer></script>\n</head>|i"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
