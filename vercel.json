{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/guides/index.html",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^calculatepilot\\.com$"
        }
      ],
      "destination": "https://www.calculatepilot.com/$1",
      "permanent": true
    },
    {
      "source": "/(fr|de|es)(financial|health|math|other)-calculators.html",
      "destination": "/$1/$2-calculators.html",
      "permanent": true
    },
    {
      "source": "/financial/car-depreciation-calculator.html",
      "destination": "/other/car-depreciation-calculator.html",
      "permanent": true
    },
    {
      "source": "/css/style.css",
      "destination": "/css/styles.css",
      "permanent": true
    },
    {
      "source": "/js/site.js",
      "destination": "/js/language-selector.js",
      "permanent": true
    },
    {
      "source": "/js/percentage-calculator.js",
      "destination": "/js/percentage.js",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|ico|jpe?g)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=UTF-8"
        }
      ]
    }
  ]
}
