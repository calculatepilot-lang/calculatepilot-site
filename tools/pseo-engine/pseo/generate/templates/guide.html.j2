<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="robots" content="index,follow">
{{ shell_head|safe }}
<style>
.pseo-guide{max-width:760px;margin:0 auto;padding:16px;font-family:Inter,system-ui,sans-serif;line-height:1.6;color:#1b2b28}
.pseo-guide h1,.pseo-guide h2{font-family:"Space Grotesk",Inter,system-ui,sans-serif;color:#0F6B5C}
.pseo-guide .crumbs{font-size:.9rem;margin-bottom:8px}
.pseo-guide .byline{color:#4a5b57;font-size:.9rem}
.pseo-guide .note{border-left:4px solid #0F6B5C;background:#eef6f4;padding:8px 12px}
.pseo-guide .table-wrap{overflow-x:auto}
.pseo-guide table{border-collapse:collapse;width:100%}
.pseo-guide th,.pseo-guide td{border:1px solid #cfdad7;padding:6px 10px;text-align:left;font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:.9rem}
.pseo-guide th{background:#eef6f4}
</style>
<script type="application/ld+json">{{ jsonld|safe }}</script>
</head>
<body>
{{ shell_header|safe }}
<main class="pseo-guide">
<article>
<nav aria-label="Breadcrumb" class="crumbs">{% for name, link in breadcrumbs %}{% if loop.last %}<span>{{ name }}</span>{% else %}<a href="{{ link }}">{{ name }}</a> &rsaquo; {% endif %}{% endfor %}</nav>
<h1>{{ h1 }}</h1>
<p class="byline">By <span>{{ author }}</span> &middot; <time datetime="{{ date_iso }}">{{ date_iso }}</time></p>
<p class="lead">{{ description }}</p>
{% if medical_note %}<p class="note medical">{{ medical_note }}</p>{% endif %}
<section id="quick-answer">
<h2>Quick answer</h2>
<p>{{ quick }}</p>
{% if also %}<p>People also search for: {{ also|join("; ") }}.</p>{% endif %}
</section>
<section id="worked-example">
<h2>Worked example</h2>
<p>These steps use the formula behind the {{ calc_name }}, with the example inputs above.</p>
<ol>{% for s in steps %}<li>{{ s }}</li>{% endfor %}</ol>
{% if breakdown_rows %}<div class="table-wrap"><table>
<caption>{{ breakdown_caption }}</caption>
<tr>{% for h in breakdown_head %}<th>{{ h }}</th>{% endfor %}</tr>
{% for row in breakdown_rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}</table></div>{% endif %}
</section>
<section id="scenario-table">
<h2>Scenarios</h2>
<p>Same formula, different {{ vary_label }}. Everything else stays at the example inputs.</p>
<div class="table-wrap"><table>
<tr>{% for h in scenario_head %}<th>{{ h }}</th>{% endfor %}</tr>
{% for row in scenario_rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}</table></div>
</section>
<section id="assumptions">
<h2>Assumptions and who this is not for</h2>
<ul>{% for a in assumptions %}<li>{{ a }}</li>{% endfor %}</ul>
</section>
{% if facts %}<section id="facts">
<h2>Official figures</h2>
<ul>{% for f in facts %}<li>{{ f.label }}: {{ f.value }} (Source: <a href="{{ f.source_url }}" rel="noopener">{{ f.source_url }}</a>, verified <time datetime="{{ f.verified_at }}">{{ f.verified_at }}</time>)</li>{% endfor %}</ul>
</section>{% endif %}
{% if faq %}<section id="faq">
<h2>Questions people ask</h2>
{% for q, a in faq %}<h3>{{ q }}</h3>
<p>{{ a }}</p>
{% endfor %}</section>{% endif %}
<section id="related">
<h2>Related</h2>
<ul>{% for label, link in related %}<li><a href="{{ link }}">{{ label }}</a></li>{% endfor %}</ul>
</section>
<section id="how-made">
<h2>How this page was made</h2>
<p>{{ how_made }}</p>
</section>
</article>
</main>
{{ shell_footer|safe }}
</body>
</html>
