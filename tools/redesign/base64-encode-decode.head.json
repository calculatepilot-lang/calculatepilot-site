   "mainEntity": [
    {
     "@type": "Question",
     "name": "What is Base64 used for?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Carrying binary data through text-only systems, such as email attachments, data URIs, JSON tokens (JWT) and HTTP Basic authentication headers."
     }
    },
    {
     "@type": "Question",
     "name": "Is Base64 encryption?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. It only re-writes bytes with a different alphabet. Anyone can decode it."
     }
    },
    {
     "@type": "Question",
     "name": "Why does the output end with =?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Padding. Base64 works in groups of 3 bytes. When the input is not a multiple of 3, one or two = characters complete the last group."
     }
    },
    {
     "@type": "Question",
     "name": "What is URL-safe Base64?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A variant that uses - and _ instead of + and /, so it can sit in URLs and file names. JWTs also leave off the = padding."
     }
    },
    {
     "@type": "Question",
     "name": "Why is the output bigger?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Every 3 bytes become 4 characters, about 33% larger, plus line breaks if you wrap lines."
     }
    }
   ]
  }
