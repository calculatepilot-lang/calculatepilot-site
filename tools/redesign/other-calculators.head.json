   "@context": "https://schema.org",
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "How accurate are the material estimates?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "They are estimates. Concrete, paint, tile, mulch and lumber calculators add a waste allowance for cuts, spills and uneven ground, and coverage rates such as paint spread or bag yield vary by product. Use the result as a shopping guide and check the label or ask your supplier before ordering."
     }
    },
    {
     "@type": "Question",
     "name": "Do these calculators store the numbers I enter?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. The calculations run in your browser and the values you enter are not sent to or stored on our servers. Like most websites, the site itself uses analytics and advertising cookies, so see our privacy policy for details."
     }
    },
    {
     "@type": "Question",
     "name": "Why can business-day and holiday results differ from my employer or contract?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Contracts and laws define how days are counted and which holidays apply. The date calculator lists US federal, UK, Canadian and Australian national holidays, but it does not include regional or one-off holidays. Add those as extra days off and check your own rules."
     }
    },
    {
     "@type": "Question",
     "name": "Are the electricity, fuel and commute costs exact?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "They are estimates based on the rates and prices you enter. Your real bill may include fixed charges, tiered or time-of-use rates, taxes and changing fuel prices, so update the inputs with your latest bill or receipt."
     }
    },
    {
     "@type": "Question",
     "name": "Can I embed an Everyday calculator on my own website?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Most calculators have a free responsive embed, and the embed code is at the bottom of each page. Branding removal is available on a paid plan."
     }
    }
   ]
