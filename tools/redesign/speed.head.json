     "@type": "Question",
     "name": "How do I calculate speed?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Divide the distance by the time taken. 26.2 miles in 3.5 hours is 7.49 mph."
     }
    },
    {
     "@type": "Question",
     "name": "How do I convert pace to speed?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Divide 60 by the pace in minutes per mile to get mph. An 8:00 mile is 60 ÷ 8 = 7.5 mph."
     }
    },
    {
     "@type": "Question",
     "name": "How long is a marathon?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "42.195 kilometres, which is 26.2 miles (26 miles 385 yards)."
     }
    },
    {
     "@type": "Question",
     "name": "What is a knot?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "One nautical mile per hour, or 1.852 km/h. It is used at sea and in aviation."
     }
    },
    {
     "@type": "Question",
     "name": "Is average speed the same as average of speeds?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. Average speed is total distance divided by total time. Driving out at 60 mph and back at 40 mph averages 48 mph, not 50."
     }
