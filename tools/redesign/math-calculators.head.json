   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What's the difference between sample and population standard deviation?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Population standard deviation divides the squared deviations by N, the number of values, and is used when you have every member of the group. Sample standard deviation divides by n − 1 (Bessel's correction), which gives a better estimate of the population's spread when your data is only a sample."
     }
    },
    {
     "@type": "Question",
     "name": "What's the difference between a permutation and a combination?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "In a permutation the order matters, so ABC and CBA count as different arrangements. In a combination the order doesn't matter, so they count as the same selection. For the same n and r there are always at least as many permutations as combinations: nPr = nCr × r!."
     }
    },
    {
     "@type": "Question",
     "name": "Why do some results show tiny rounding differences?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Computers store most decimals in binary floating point (IEEE 754 double precision), which can't represent numbers like 0.1 exactly — for example 0.1 + 0.2 is stored as 0.30000000000000004. Results are rounded for display, so these tiny differences rarely matter, but for exact work use fractions or the precision your course requires."
     }
    },
    {
     "@type": "Question",
     "name": "Do these calculators store the numbers I enter?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. The calculations run in your browser and the numbers you enter aren't sent to or stored on our servers. Like most websites, the site itself uses analytics and advertising cookies — see our privacy policy for details."
     }
    },
    {
     "@type": "Question",
     "name": "Can I use these calculators for homework?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — they're a good way to check your answers. Each page shows the formula, so you can follow the method, but follow your teacher's rules on rounding, significant figures and showing your working."
     }
    }
