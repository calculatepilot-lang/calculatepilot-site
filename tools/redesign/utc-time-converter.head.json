   "mainEntity": [
    {
     "@type": "Question",
     "name": "What is UTC?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Coordinated Universal Time, the world's time standard. It does not change for daylight saving. GMT is the same clock in practice."
     }
    },
    {
     "@type": "Question",
     "name": "What does Zulu mean?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Zulu is the military and aviation name for UTC. The letter Z stands for zero offset, so 1430Z is 14:30 UTC."
     }
    },
    {
     "@type": "Question",
     "name": "Is daylight saving handled?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Each zone's offset is worked out for the date you enter, so New York is UTC−4 in summer and UTC−5 in winter."
     }
    },
    {
     "@type": "Question",
     "name": "What is Unix time?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "The number of seconds since 1 January 1970 at 00:00 UTC. It is the same everywhere."
     }
    },
    {
     "@type": "Question",
     "name": "Why does the day change in some cities?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A time near midnight UTC can already be the next day in zones ahead of UTC, such as Tokyo or Sydney."
     }
    }
   ]
