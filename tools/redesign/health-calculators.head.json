   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "Why does BMI have different cut-offs for Asian populations?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A 2004 WHO expert consultation found that many Asian populations have a higher proportion of body fat and higher risk of type 2 diabetes and heart disease at a lower BMI than European populations. It kept the international categories but proposed additional public-health action points of 23 (increased risk) and 27.5 (high risk) for Asian populations."
     }
    },
    {
     "@type": "Question",
     "name": "Why check waist-to-height ratio as well as BMI?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "BMI can't tell muscle from fat or show where fat is stored. Waist-to-height ratio reflects fat around the middle, which is more closely linked to heart and metabolic risk. A common guide is to keep your waist to less than half your height (a ratio below 0.5)."
     }
    },
    {
     "@type": "Question",
     "name": "Is the 3,500-calorie rule accurate for weight loss?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Only as a rough starting point. The idea that a 3,500-calorie deficit always removes one pound of fat assumes your energy use stays constant, but it falls as you lose weight, so loss usually slows over time. Treat any weight-loss timeline as an estimate and adjust it from your actual progress."
     }
    },
    {
     "@type": "Question",
     "name": "Do these calculators store my health data?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. The calculations run in your browser and the numbers you enter aren't sent to or stored on our servers. Like most websites, the site itself uses analytics and advertising cookies — see our privacy policy for details."
     }
    },
    {
     "@type": "Question",
     "name": "Are these calculators medical advice?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. They use published formulas to give estimates for general information. Results can be less accurate for children, pregnant women, older adults and athletes; talk to a doctor or registered dietitian about decisions for your health."
     }
    }
